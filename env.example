DATABASE_NAME=default_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_ENGINE=postgresql
DATABASE_HOST=db
DATABASE_PORT=5432

DJANGO_SECRET_KEY=super duper secret key
DJANGO_ALLOWED_HOSTS=127.0.0.1
DJANGO_TRUSTED_ORIGINS=http://127.0.0.1
# Can be DEBUG, INFO, WARNING, ERROR or CRITICAL
DJANGO_LOG_LEVEL=WARNING

# Email
DJANGO_EMAIL_MODE=smtp
# Change this to match the domain set up in the mail service if DJANGO_EMAIL_MODE=prod
DJANGO_DEFAULT_EMAIL_SENDER=noreply@example.dk
# Email SMTP (required DJANGO_EMAIL_MODE == prod)
# More options available in settings.py
DJANGO_EMAIL_PORT=1025
DJANGO_EMAIL_HOST=mailpit
DJANGO_EMAIL_HOST_USER=user1
DJANGO_EMAIL_HOST_PASSWORD=password1
DJANGO_EMAIL_USE_TLS=False

DEBUG=1
DEV_TEST_DATA_PROVISION=1

# Mailpit (dev only)
MP_SMTP_AUTH="user1:password1"
